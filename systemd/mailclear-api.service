[Unit]
Description=MailClear API HTTP (porta 8181)
Documentation=https://github.com/rafaelwdornelas/mailclear
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
Requires=postgresql.service unbound.service

[Service]
Type=notify
User=mailclear
Group=mailclear
ExecStart=/opt/mailclear/bin/mailclear-api
Restart=on-failure
RestartSec=5s

# Limites de recursos
LimitNOFILE=1048576
LimitNPROC=65535

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/mailclear /var/log/mailclear

# Logs em journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mailclear-api

# Bumped para 180s: graceful shutdown drena pool (até 120s) + http (20s) +
# margem. Sem isso, systemd SIGKILL durante drain perde batches em curso.
TimeoutStopSec=180s
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
